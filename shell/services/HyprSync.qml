pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io
import "../theme"

// Đưa cài đặt của người dùng vào Hyprland:
//   · màu viền cửa sổ theo màu nhấn
//   · độ phân giải / tỉ lệ từng màn hình
// Áp dụng ngay bằng `hyprctl eval`, đồng thời ghi ~/.config/islet/hypr-user.lua
// (hyprland.lua nạp file này lúc khởi động) để lần sau vẫn giữ.
Singleton {
    id: root

    readonly property string file: Prefs.dir + "/hypr-user.lua"

    function hex(c) {
        const h = x => ("0" + Math.round(x * 255).toString(16)).slice(-2);
        return h(c.r) + h(c.g) + h(c.b);
    }
    readonly property string lua: {
        if (!Prefs.loaded) return "";
        const a = hex(Prefs.accent);
        const out = ["-- Generated by Islet › Settings. Do not edit: it will be overwritten.",
            `hl.config({ general = { col = { active_border = { colors = { "rgba(${a}ee)", "rgba(ff6b97ee)" }, angle = 45 } } } })`];
        out.push(`hl.config({ input = { sensitivity = ${Prefs.pointerSpeed.toFixed(2)}, touchpad = { natural_scroll = ${Prefs.naturalScroll}, tap_to_click = ${Prefs.tapToClick}, disable_while_typing = ${Prefs.disableWhileTyping}, scroll_factor = ${Prefs.scrollSpeed.toFixed(2)} } } })`);
        for (const name in Prefs.monitors) {
            const m = Prefs.monitors[name];
            out.push(`hl.monitor({ output = "${name}", mode = "${m.mode || "preferred"}", position = "auto", scale = ${m.scale || 1} })`);
        }
        return out.join("\n") + "\n";
    }
    onLuaChanged: if (lua) apply.restart()

    Timer {
        id: apply
        interval: 400
        onTriggered: {
            out.setText(root.lua);
            Quickshell.execDetached(["hyprctl", "eval", root.lua.split("\n").slice(1).join("\n")]);
        }
    }
    FileView { id: out; path: root.file; blockLoading: false }
}
