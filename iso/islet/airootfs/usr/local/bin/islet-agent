#!/usr/bin/env python3
"""Cầu nối giữa các agent lập trình (Claude Code, Codex, Gemini CLI, OpenCode) và island của Islet.

    islet-agent setup               nối Claude Code (hooks) và Codex (notify) với Islet — chạy lại thoải mái,
                                    chỉ thêm phần của Islet, không đụng cấu hình khác của bạn
    islet-agent hook claude         được Claude Code gọi (JSON sự kiện ở stdin)
    islet-agent hook codex '<json>' được Codex gọi khi xong một lượt
    islet-agent watch-opencode      nghe luồng sự kiện của OpenCode (shell chạy nền lệnh này)
    islet-agent ps                  liệt kê agent đang chạy (JSON) — shell dùng để thấy cả agent không có hook
    islet-agent unsetup             gỡ phần của Islet khỏi cấu hình Claude Code / Codex

Hook không bao giờ in ra stdout (với Claude Code, stdout của UserPromptSubmit bị chèn vào ngữ cảnh) và
luôn thoát 0 thật nhanh để không làm chậm agent.
"""
import json
import os
import re
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
HOOK_CMD = "islet-agent hook claude"
CLAUDE_EVENTS = ["SessionStart", "UserPromptSubmit", "PreToolUse", "Notification", "Stop", "SessionEnd"]
AGENTS = {  # tên tiến trình → agent
    "claude": "claude", "codex": "codex", "gemini": "gemini", "opencode": "opencode",
}


# ---------------------------------------------------------------- tiện ích
def ancestors(pid):
    out = []
    while pid > 1 and len(out) < 40:
        out.append(pid)
        try:
            with open(f"/proc/{pid}/stat") as f:
                pid = int(f.read().rsplit(")", 1)[1].split()[1])
        except Exception:
            break
    return out


def send(ev):
    """Gửi sự kiện cho shell qua IPC; không chờ lâu, không bao giờ làm hỏng agent."""
    try:
        # chạy nền, tách khỏi agent: hook thoát ngay, agent không phải đợi
        subprocess.Popen(["islet-ipc", "agents", "event", json.dumps(ev, ensure_ascii=False)],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except Exception:
        pass


def short(s, n=160):
    s = re.sub(r"\s+", " ", str(s or "")).strip()
    return s if len(s) <= n else s[: n - 1] + "…"


# ---------------------------------------------------------------- hook
def hook_claude():
    try:
        d = json.load(sys.stdin)
    except Exception:
        return
    name = d.get("hook_event_name", "")
    state, msg = None, ""
    if name == "SessionStart":
        state = "idle"
    elif name in ("UserPromptSubmit", "PreToolUse", "PostToolUse"):
        state = "working"
        if name == "PreToolUse":
            msg = d.get("tool_name", "")
        elif name == "UserPromptSubmit":
            msg = short(d.get("prompt", ""), 120)
    elif name == "Notification":
        kind = d.get("notification_type", "")
        msg = short(d.get("message", ""))
        if kind == "permission_prompt" or (not kind and "permission" in msg.lower()):
            state = "attention"
        elif kind == "idle_prompt":
            state = "waiting"
        else:
            state = "attention" if "permission" in msg.lower() or "approve" in msg.lower() else "waiting"
    elif name in ("Stop", "SubagentStop"):
        state = "done" if name == "Stop" else None
    elif name == "SessionEnd":
        state = "end"
    if not state:
        return
    send({"agent": "claude", "session": d.get("session_id", ""), "state": state, "cwd": d.get("cwd") or os.getcwd(),
          "message": msg, "pids": ancestors(os.getppid())})


def hook_codex(arg):
    try:
        d = json.loads(arg)
    except Exception:
        return
    t = str(d.get("type", ""))
    state = "attention" if "approval" in t else "done" if "complete" in t else None
    if not state:
        return
    send({"agent": "codex", "session": str(d.get("thread-id") or d.get("thread_id") or ""), "state": state,
          "cwd": d.get("cwd") or os.getcwd(), "message": short(d.get("last-assistant-message", "")),
          "pids": ancestors(os.getppid())})


def hook_opencode(arg):
    try:
        d = json.loads(arg)
    except Exception:
        return
    state = d.get("state")
    if state not in ("working", "attention", "done", "idle", "end"):
        return
    pid = int(d.get("pid") or os.getppid())
    send({"agent": "opencode", "session": str(d.get("session") or ""), "state": state,
          "cwd": d.get("cwd") or os.getcwd(), "message": short(d.get("message", "")), "pids": ancestors(pid)})


# ---------------------------------------------------------------- ps
def agent_of(pid):
    try:
        cmd = open(f"/proc/{pid}/cmdline", "rb").read().split(b"\0")
    except Exception:
        return None
    args = [a.decode(errors="replace") for a in cmd if a]
    if not args:
        return None
    for a in args[:3]:  # vd. "node /usr/bin/gemini", "/usr/bin/claude"
        base = os.path.basename(a)
        if base in AGENTS:
            return AGENTS[base]
        if "@anthropic-ai/claude-code" in a:
            return "claude"
        if "@google/gemini-cli" in a:
            return "gemini"
        if "@openai/codex" in a:
            return "codex"
    return None


def ps():
    found = {}
    for p in os.listdir("/proc"):
        if not p.isdigit():
            continue
        pid = int(p)
        a = agent_of(pid)
        if not a:
            continue
        try:
            st = open(f"/proc/{pid}/stat").read().rsplit(")", 1)[1].split()
            ppid, ticks = int(st[1]), int(st[11]) + int(st[12])
            cwd = os.readlink(f"/proc/{pid}/cwd")
        except Exception:
            continue
        found[pid] = {"pid": pid, "ppid": ppid, "agent": a, "ticks": ticks, "cwd": cwd}
    # chỉ giữ tiến trình gốc của mỗi agent (bỏ tiến trình con cùng loại); cộng CPU của con vào gốc
    out = []
    for pid, f in found.items():
        par = found.get(f["ppid"])
        if par and par["agent"] == f["agent"]:
            continue
        kids = [k for k in found.values() if k["ppid"] == pid and k["agent"] == f["agent"]]
        f["ticks"] += sum(k["ticks"] for k in kids)
        f["pids"] = ancestors(pid)
        out.append(f)
    print(json.dumps(out))


# ---------------------------------------------------------------- setup
def setup_claude(remove=False):
    path = os.path.join(HOME, ".claude", "settings.json")
    if not remove and not (os.path.isdir(os.path.dirname(path)) or shutil.which("claude")):
        return "skip"
    try:
        d = json.load(open(path)) if os.path.exists(path) else {}
    except Exception:
        return "unreadable"          # không đụng vào file hỏng / lạ
    if not isinstance(d, dict):
        return "unreadable"
    hooks = d.setdefault("hooks", {})
    changed = False
    for ev in CLAUDE_EVENTS:
        lst = hooks.get(ev, [])
        mine = [e for e in lst if any(h.get("command", "").startswith(HOOK_CMD) for h in e.get("hooks", []))]
        if remove:
            if mine:
                hooks[ev] = [e for e in lst if e not in mine]
                if not hooks[ev]:
                    del hooks[ev]
                changed = True
        elif not mine:
            entry = {"hooks": [{"type": "command", "command": HOOK_CMD, "timeout": 5}]}
            if ev == "PreToolUse":
                entry["matcher"] = "*"
            hooks[ev] = lst + [entry]
            changed = True
    if remove and not hooks:
        d.pop("hooks", None)
    if changed:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        if os.path.exists(path) and not os.path.exists(path + ".islet-backup"):
            shutil.copy2(path, path + ".islet-backup")
        tmp = path + ".islet-tmp"
        with open(tmp, "w") as f:
            json.dump(d, f, indent=2)
            f.write("\n")
        os.replace(tmp, path)
    return "ok"


CODEX_LINE = 'notify = ["islet-agent", "hook", "codex"]'


def setup_codex(remove=False):
    path = os.path.join(HOME, ".codex", "config.toml")
    if not remove and not (os.path.isdir(os.path.dirname(path)) or shutil.which("codex")):
        return "skip"
    text = open(path).read() if os.path.exists(path) else ""
    if remove:
        if CODEX_LINE in text:
            open(path, "w").write(text.replace(CODEX_LINE + "\n", "").replace(CODEX_LINE, ""))
        return "ok"
    if re.search(r"(?m)^\s*notify\s*=", text):
        return "ok" if CODEX_LINE in text else "own-notify"   # bạn đã có notify riêng → giữ nguyên
    os.makedirs(os.path.dirname(path), exist_ok=True)
    # khoá cấp gốc phải nằm trước mọi [bảng] trong TOML → đặt lên đầu file
    open(path, "w").write(CODEX_LINE + "\n" + text)
    return "ok"


# ---------------------------------------------------------------- OpenCode (luồng sự kiện)
# OpenCode 2.x chạy một server nền (127.0.0.1, mật khẩu ở ~/.config/opencode/service.json); TUI và
# `opencode run` đều nhận sự kiện qua GET /api/event?directory=<thư mục>. Islet nghe đúng luồng đó.
OC_SERVICE = os.path.join(HOME, ".config", "opencode", "service.json")


def oc_servers():
    """[(port, pid)] các server opencode đang nghe trên localhost."""
    out = subprocess.run(["ss", "-ltnpH"], capture_output=True, text=True).stdout
    res = []
    for line in out.splitlines():
        if '"opencode"' not in line:
            continue
        m = re.search(r"127\.0\.0\.1:(\d+)", line)
        pm = re.search(r"pid=(\d+)", line)
        if m:
            res.append((int(m.group(1)), int(pm.group(1)) if pm else 0))
    return res


def oc_dirs():
    """{thư mục: pid} của các tiến trình opencode (TUI / run) đang mở."""
    dirs = {}
    for p in os.listdir("/proc"):
        if p.isdigit() and agent_of(int(p)) == "opencode":
            try:
                dirs.setdefault(os.readlink(f"/proc/{p}/cwd"), int(p))
            except Exception:
                pass
    return dirs


def oc_stream(port, directory, password, alive):
    import base64
    import threading
    import urllib.parse
    import urllib.request
    url = f"http://127.0.0.1:{port}/api/event?directory=" + urllib.parse.quote(directory)
    auth = base64.b64encode(f"opencode:{password}".encode()).decode()
    texts, busy = {}, {}
    try:
        req = urllib.request.Request(url, headers={"Authorization": "Basic " + auth, "Accept": "text/event-stream"})
        with urllib.request.urlopen(req, timeout=None) as r:
            for raw in r:
                if not alive.get((port, directory)):
                    return
                line = raw.decode(errors="replace").strip()
                if not line.startswith("data:"):
                    continue
                try:
                    ev = json.loads(line[5:])
                except Exception:
                    continue
                t, d = ev.get("type", ""), ev.get("data") or {}
                sid = d.get("sessionID", "")
                state, msg = None, ""
                if t == "session.execution.started":
                    state, busy[sid], texts[sid] = "working", True, ""
                elif t == "session.text.ended":
                    texts[sid] = d.get("text", "") or texts.get(sid, "")
                elif t == "session.execution.succeeded":
                    state, msg, busy[sid] = "done", texts.get(sid, ""), False
                elif t == "session.execution.failed":
                    state, msg, busy[sid] = "done", "Stopped with an error", False
                elif t == "session.execution.interrupted":
                    state, busy[sid] = "idle", False
                elif t == "permission.asked":
                    state = "attention"
                    msg = d.get("title") or d.get("permission") or d.get("tool") or "Permission needed"
                elif t in ("permission.replied", "permission.rejected"):
                    state = "working" if busy.get(sid) else None
                if state:
                    pid = oc_dirs().get(directory, 0)
                    send({"agent": "opencode", "session": sid, "state": state, "cwd": directory,
                          "message": short(msg), "pids": ancestors(pid) if pid else []})
    except Exception:
        pass
    finally:
        alive.pop((port, directory), None)


def watch_opencode():
    import threading
    import time
    alive = {}
    while True:
        try:
            pw = json.load(open(OC_SERVICE)).get("password", "") if os.path.exists(OC_SERVICE) else ""
            servers = oc_servers() if pw else []
            dirs = oc_dirs() if servers else {}
            for port, _ in servers:
                for d in dirs:
                    if (port, d) not in alive:
                        alive[(port, d)] = True
                        threading.Thread(target=oc_stream, args=(port, d, pw, alive), daemon=True).start()
            # thư mục không còn opencode nào → ngừng nghe
            for k in list(alive):
                if k[1] not in dirs or k[0] not in [p for p, _ in servers]:
                    alive[k] = False
        except Exception:
            pass
        time.sleep(3)


def setup_opencode(remove=False):
    # bản cũ đặt plugin ~/.config/opencode/plugins/islet.js — OpenCode 2.x không dùng, gỡ đi
    path = os.path.join(HOME, ".config", "opencode", "plugins", "islet.js")
    try:
        if os.path.exists(path) and "islet-managed" in open(path).read():
            os.remove(path)
    except Exception:
        pass
    return "events" if shutil.which("opencode") else "skip"


def main():
    a = sys.argv[1:]
    if not a:
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(2)
    if a[0] == "hook":
        try:
            if a[1:2] == ["claude"]:
                hook_claude()
            elif a[1:2] == ["codex"]:
                hook_codex(a[-1] if len(a) > 2 else "{}")
            elif a[1:2] == ["opencode"]:
                hook_opencode(a[-1] if len(a) > 2 else "{}")
        except Exception:
            pass
        sys.exit(0)
    if a[0] == "ps":
        ps()
    elif a[0] == "watch-opencode":
        watch_opencode()
    elif a[0] in ("setup", "unsetup"):
        rm = a[0] == "unsetup"
        print(json.dumps({"claude": setup_claude(rm), "codex": setup_codex(rm), "opencode": setup_opencode(rm)}))
    else:
        sys.exit(2)


if __name__ == "__main__":
    main()
